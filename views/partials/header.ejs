<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= pageTitle %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="icon" type="image/png" href="/assets/img/logo/favicon.png?v=3">
  <link rel="shortcut icon" href="/assets/img/logo/favicon.ico?v=3">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    :root{ --sidebar-w: 240px; --sidebar-w-collapsed: 72px; }
    html, body { height: 100%; overflow: hidden; }
    body { background:#f5f6f8; margin:0; }
    .topbar{
      position: sticky; top: 0; z-index: 1000; height: 56px;
      display:flex; align-items:center; padding: 0 12px; gap: 10px;
      background: #1F4E79; color: #fff;
    }
    .brand img{ height: 25px; }
    .app{ display:flex; height: calc(100vh - 56px); }

    .sidebar{
      width: var(--sidebar-w); flex: 0 0 var(--sidebar-w); background:#D9E1F2;
      height: 100%; padding: 8px 0 12px; overflow-x: hidden; overflow-y: auto;
      transition: width .18s ease, flex-basis .18s ease;
    }
    .app.sidebar-collapsed .sidebar{ width: var(--sidebar-w-collapsed); flex-basis: var(--sidebar-w-collapsed); }

    .sidebar-toggle{
      display:flex; align-items:center; justify-content:center;
      width:32px; height:32px; flex-shrink:0;
      background:transparent; border:none; border-radius:8px;
      color:#fff; cursor:pointer;
    }
    .sidebar-toggle:hover{ background: rgba(255,255,255,.15); }

    .nav-icon{ width:16px; height:16px; flex:0 0 16px; color: inherit; }
    .nav-item-link{
      display:flex; align-items:center; gap:12px; padding:10px 16px;
      color:#3C4656; text-decoration:none; white-space:nowrap; overflow:hidden;
      font-size: 14px; line-height: 1.2;
    }
    .nav-item-link:hover{ background: rgba(0,0,0,.06); }
    .nav-item-link.active{ background: rgba(31,78,121,.12); color:#1F4E79; font-weight:600; }
    .app.sidebar-collapsed .nav-item-link{ justify-content:center; padding:10px 0; }
    .app.sidebar-collapsed .nav-item-link .label{ display:none; }

    .menu-group-title{
      display:flex; align-items:center; justify-content:space-between; gap:8px;
      width:100%; font: inherit; background:none; border:none; cursor:pointer;
      font-size: 12px; text-transform: uppercase; color: #667; padding: 6px 16px 2px;
      white-space:nowrap; overflow:hidden;
    }
    .app.sidebar-collapsed .menu-group-title{
      height:1px; margin: 8px 14px; padding:0; background: rgba(0,0,0,.1);
      pointer-events:none;
    }
    .app.sidebar-collapsed .menu-group-title .label,
    .app.sidebar-collapsed .menu-group-title .chevron-icon{ display:none; }

    .chevron-icon{ width:14px; height:14px; flex:0 0 14px; transition: transform .18s ease; }
    .menu-group-title[aria-expanded="false"] .chevron-icon{ transform: rotate(-90deg); }

    .card-toggle{ cursor:pointer; }
    .card-toggle[aria-expanded="false"] .chevron-icon{ transform: rotate(-90deg); }

    .nav-subsection .menu-group-title{ padding-left: 28px; }
    .nav-subsection .nav-item-link{ padding-left: 28px; }
    .app.sidebar-collapsed .nav-subsection .menu-group-title{ margin-left: 0; padding-left: 0; }

    .nav-section-body{ display:grid; grid-template-rows: 1fr; transition: grid-template-rows .18s ease; }
    .menu-group-title[aria-expanded="false"] + .nav-section-body{ grid-template-rows: 0fr; }
    .nav-section-body-inner{ overflow:hidden; min-height:0; }
    .app.sidebar-collapsed .nav-section-body{ grid-template-rows: 1fr !important; }

    .content{ flex:1; height: 100%; padding: 16px; min-width: 0; overflow: auto; }
  </style>
</head>
<body>

<div class="topbar">
  <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Collapse sidebar" aria-expanded="true">
    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <a class="brand" href="/home">
    <img src="/assets/img/logo/mlp2.png?v=3" alt="MLP">
  </a>
  <div class="ms-auto d-flex align-items-center gap-2">
    <% if (username) { %>
      <span><%= username %> (<%= divisi || '-' %>)</span>
      <a class="btn btn-light btn-sm" href="/logout">Logout</a>
    <% } %>
  </div>
</div>

<div class="app">
<script>
  if (localStorage.getItem('sidebarCollapsed') === '1') {
    document.currentScript.parentElement.classList.add('sidebar-collapsed');
  }
</script>
