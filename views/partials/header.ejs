<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= pageTitle %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="icon" type="image/png" href="/assets/img/logo/favicon.png?v=3">
  <link rel="shortcut icon" href="/assets/img/logo/favicon.ico?v=3">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background:#f5f6f8; margin:0; }
    .topbar{
      position: sticky; top: 0; z-index: 1000; height: 56px;
      display:flex; align-items:center; padding: 0 12px; gap: 10px;
      background: #1F4E79; color: #fff;
    }
    .brand img{ height: 25px; }
    .app{ display:flex; }
    .sidebar{ width: 240px; background:#D9E1F2; min-height: calc(100vh - 56px); padding: 12px 0; }
    .nav-item-link{ display:flex; align-items:center; gap:10px; padding:10px 16px; color:#222; text-decoration:none; }
    .nav-item-link.active, .nav-item-link:hover{ background: rgba(0,0,0,.06); }
    .menu-group-title{ font-size: 12px; text-transform: uppercase; color: #667; padding: 12px 16px 4px; }
    .content{ flex:1; padding: 16px; min-width: 0; overflow-x: auto; }
  </style>
</head>
<body>

<div class="topbar">
  <a class="brand" href="/home">
    <img src="/assets/img/logo/mlp2.png?v=3" alt="MLP">
  </a>
  <div class="ms-auto d-flex align-items-center gap-2">
    <% if (username) { %>
      <span><%= username %> (<%= divisi || '-' %>)</span>
      <a class="btn btn-light btn-sm" href="/logout">Logout</a>
    <% } %>
  </div>
</div>

<div class="app">
