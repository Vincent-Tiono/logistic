<%- include('partials/header', { pageTitle: 'Jetty', username, divisi }) %>
<%- include('partials/sidebar', { divisi }) %>

<div class="content">

  <div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="m-0">Jetty</h4>
    <div class="d-flex gap-2" style="max-width:420px; width:100%;">
      <input id="searchBox" type="text" class="form-control form-control-sm"
             placeholder="Search (Jetty / Nama Panjang)">
      <button id="btnReset" class="btn btn-sm btn-outline-secondary" type="button">Reset</button>
    </div>
  </div>

  <div id="alertBox" class="alert d-none" role="alert"></div>

  <div class="card mb-3">
    <div class="card-body">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
          <h6 class="mb-1">Import CSV</h6>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <a class="btn btn-sm btn-outline-primary" href="/jetty?download=jetty_template">Download Template CSV</a>
          <% if ((divisi || '').toUpperCase() === 'IT') { %>
          <form id="formImport" class="d-flex gap-2 align-items-center">
            <input type="file" name="csv" id="csvFile" class="form-control form-control-sm" accept=".csv" required>
            <button class="btn btn-sm btn-primary" type="submit">Import</button>
          </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header card-toggle d-flex justify-content-between align-items-center" role="button"
         data-bs-toggle="collapse" data-bs-target="#collapseInputJetty" aria-expanded="false" aria-controls="collapseInputJetty">
      <h6 class="m-0">Input Jetty</h6>
      <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="collapse" id="collapseInputJetty">
    <div class="card-body">

      <form id="formCreate" class="row g-2">
        <div class="col-md-2">
          <label class="form-label">Jetty</label>
          <input name="jetty" class="form-control" placeholder="ABK" required>
        </div>
        <div class="col-md-10">
          <label class="form-label">Nama Panjang</label>
          <textarea name="nama_panjang" class="form-control" rows="3"
            placeholder="Nama panjang jetty..." required></textarea>
        </div>
        <div class="col-12">
          <button class="btn btn-success" type="submit">Save</button>
        </div>
      </form>
    </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <h6 class="mb-3">Data Jetty</h6>
      <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
          <thead class="table-light">
            <tr>
              <th style="min-width:110px;">Jetty</th>
              <th>Nama Panjang</th>
              <th style="width:190px;">Action</th>
            </tr>
          </thead>
          <tbody id="tbody">
            <tr><td colspan="3" class="text-center text-muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>

      <% if ((divisi || '').toUpperCase() === 'IT') { %>
      <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-sm btn-danger" id="btnDeleteAll" type="button">Delete All</button>
      </div>
      <% } %>
    </div>
  </div>

</div>

<script>
const alertBox = document.getElementById('alertBox');

function showAlert(type, msg){
  alertBox.className = 'alert alert-' + type;
  alertBox.textContent = msg;
  alertBox.classList.remove('d-none');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function hideAlert(){
  alertBox.classList.add('d-none');
}

function escapeHtml(s){
  return String(s ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');
}

async function postAjax(payload){
  const form = new URLSearchParams(payload);
  const res = await fetch('/jetty', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
    body: form.toString()
  });
  return await res.json();
}

const tbody = document.getElementById('tbody');

function rowTemplate(r){
  const jetty = escapeHtml(r.jetty);

  return `
  <tr data-jetty="${jetty}">
    <td><input class="form-control form-control-sm" value="${jetty}" disabled></td>
    <td><textarea class="form-control form-control-sm" name="nama_panjang" rows="3">${escapeHtml(r.nama_panjang)}</textarea></td>
    <td class="d-flex gap-2">
      <button class="btn btn-sm btn-primary btnUpdate" type="button">Update</button>
      <button class="btn btn-sm btn-outline-danger btnDelete" type="button">Delete</button>
    </td>
  </tr>`;
}

async function loadJetties(q=''){
  const res = await fetch('/jetty?ajax=1&action=list&q=' + encodeURIComponent(q));
  const r = await res.json();
  if (!r.ok){
    tbody.innerHTML = `<tr><td colspan="3" class="text-center text-danger">${escapeHtml(r.msg || 'Error')}</td></tr>`;
    return;
  }
  if (!r.data || r.data.length === 0){
    tbody.innerHTML = `<tr><td colspan="3" class="text-center text-muted">No data</td></tr>`;
    return;
  }
  tbody.innerHTML = r.data.map(rowTemplate).join('');
}

const searchBox = document.getElementById('searchBox');
const btnReset  = document.getElementById('btnReset');

let t = null;
searchBox.addEventListener('input', () => {
  hideAlert();
  clearTimeout(t);
  t = setTimeout(() => loadJetties(searchBox.value.trim()), 250);
});

btnReset.addEventListener('click', () => {
  searchBox.value = '';
  hideAlert();
  loadJetties('');
});

const formCreate = document.getElementById('formCreate');
formCreate.addEventListener('submit', async (e) => {
  e.preventDefault();
  hideAlert();

  const fd = new FormData(formCreate);
  const payload = { action: 'create' };
  for (const [k, v] of fd.entries()) payload[k] = v.toString().trim();

  const r = await postAjax(payload);
  if (r.ok){
    showAlert('success', r.msg || 'OK');
    formCreate.reset();
    loadJetties(searchBox.value.trim());
  } else {
    showAlert('danger', r.msg || 'Gagal');
  }
});

tbody.addEventListener('click', async (e) => {
  const tr = e.target.closest('tr');
  if (!tr) return;
  const jetty = tr.getAttribute('data-jetty') || '';

  if (e.target.classList.contains('btnUpdate')){
    hideAlert();
    const payload = { action: 'update', jetty };
    tr.querySelectorAll('input[name], textarea[name]').forEach(el => {
      payload[el.name] = el.value.trim();
    });

    const r = await postAjax(payload);
    if (r.ok){
      showAlert('success', r.msg || 'Updated');
      loadJetties(searchBox.value.trim());
    } else {
      showAlert('danger', r.msg || 'Gagal update');
    }
  }

  if (e.target.classList.contains('btnDelete')){
    hideAlert();
    if (!jetty) return;
    if (!confirm('Hapus jetty ' + jetty + ' ?')) return;

    const r = await postAjax({ action: 'delete', jetty });
    if (r.ok){
      showAlert('success', r.msg || 'Deleted');
      loadJetties(searchBox.value.trim());
    } else {
      showAlert('danger', r.msg || 'Gagal delete');
    }
  }
});

const formImport = document.getElementById('formImport');
if (formImport) {
  formImport.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const csvFile = document.getElementById('csvFile');
    if (!csvFile.files.length) return;

    const fd = new FormData();
    fd.append('action', 'import_csv');
    fd.append('csv', csvFile.files[0]);

    const res = await fetch('/jetty', { method: 'POST', body: fd });
    const r = await res.json();
    if (r.ok){
      showAlert('success', r.msg || 'Import selesai');
      formImport.reset();
      loadJetties(searchBox.value.trim());
    } else {
      showAlert('danger', r.msg || 'Gagal import');
    }
  });
}

const btnDeleteAll = document.getElementById('btnDeleteAll');
if (btnDeleteAll) {
  btnDeleteAll.addEventListener('click', async () => {
    hideAlert();
    if (!confirm('Hapus SEMUA data jetty? Tindakan ini tidak bisa dibatalkan.')) return;

    const r = await postAjax({ action: 'delete_all' });
    if (r.ok){
      showAlert('success', r.msg || 'Deleted');
      loadJetties(searchBox.value.trim());
    } else {
      showAlert('danger', r.msg || 'Gagal');
    }
  });
}

loadJetties('');
</script>

<%- include('partials/footer') %>
