<%- include('partials/header', { pageTitle: 'FLF', username, divisi }) %>
<%- include('partials/sidebar', { divisi }) %>

<div class="content">

  <div class="d-flex align-items-center justify-content-between mb-3">
    <h4 class="m-0">FLF</h4>
    <div class="d-flex gap-2" style="max-width:420px; width:100%;">
      <input id="searchBox" type="text" class="form-control form-control-sm"
             placeholder="Search (Floating Crane / Vendor / PBM / Anchorage)">
      <button id="btnReset" class="btn btn-sm btn-outline-secondary" type="button">Reset</button>
    </div>
  </div>
  <div id="alertBox" class="alert d-none" role="alert"></div>

  <div class="card mb-3">
    <div class="card-body">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
          <h6 class="mb-1">Import CSV</h6>
        </div>
        <div class="d-flex gap-2 align-items-center">
          <a class="btn btn-sm btn-outline-primary" href="/flf?download=flf_template">Download Template CSV</a>
          <% if ((divisi || '').toUpperCase() === 'IT') { %>
          <form id="formImport" class="d-flex gap-2 align-items-center">
            <input type="file" name="csv" id="csvFile" class="form-control form-control-sm" accept=".csv" required>
            <button class="btn btn-sm btn-primary" type="submit">Import</button>
          </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header card-toggle d-flex justify-content-between align-items-center" role="button"
         data-bs-toggle="collapse" data-bs-target="#collapseInputFlf" aria-expanded="false" aria-controls="collapseInputFlf">
      <h6 class="m-0">Input FLF</h6>
      <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="collapse" id="collapseInputFlf">
    <div class="card-body">

      <form id="formCreate" class="row g-2">
        <div class="col-md-4">
          <label class="form-label">Floating Crane</label>
          <input name="floating_crane" class="form-control" placeholder="FC RATU DEWATA" required>
        </div>
        <div class="col-md-2">
          <label class="form-label">Vendor FLF</label>
          <input name="vendor_flf" class="form-control" placeholder="PSS" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">PBM</label>
          <input name="pbm" class="form-control" placeholder="FLOATING CRANE" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Anchorage</label>
          <input name="anchorage" class="form-control" placeholder="M.BERAU" required>
        </div>
        <div class="col-12">
          <button class="btn btn-success" type="submit">Save</button>
        </div>
      </form>
    </div>
    </div>
  </div>

  <div class="card">
    <div class="card-body">
      <h6 class="mb-3">Data FLF</h6>
      <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
          <thead class="table-light">
            <tr>
              <th style="min-width:220px;">Floating Crane</th>
              <th style="min-width:120px;">Vendor</th>
              <th style="min-width:180px;">PBM</th>
              <th style="min-width:140px;">Anchorage</th>
              <th style="width:190px;">Action</th>
            </tr>
          </thead>
          <tbody id="tbody">
            <tr><td colspan="5" class="text-center text-muted">Loading...</td></tr>
          </tbody>
        </table>
      </div>

      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <div class="d-flex align-items-center gap-2 small text-muted">
          Show
          <select id="flfPageSize" class="form-select form-select-sm" style="width:auto;">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
          entries (<span id="flfPageInfo">Showing 0 to 0 of 0 entries</span>)
        </div>
        <nav>
          <ul class="pagination pagination-sm mb-0" id="flfPageButtons"></ul>
        </nav>
      </div>

      <% if ((divisi || '').toUpperCase() === 'IT') { %>
      <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-sm btn-danger" id="btnDeleteAll" type="button">Delete All</button>
      </div>
      <% } %>
    </div>
  </div>

</div>

<script>
const alertBox = document.getElementById('alertBox');

function showAlert(type, msg){
  alertBox.className = 'alert alert-' + type;
  alertBox.textContent = msg;
  alertBox.classList.remove('d-none');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function hideAlert(){
  alertBox.classList.add('d-none');
}

function escapeHtml(s){
  return String(s ?? '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#039;');
}

async function postAjax(payload){
  const form = new URLSearchParams(payload);
  const res = await fetch('/flf', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
    body: form.toString()
  });
  return await res.json();
}

const tbody = document.getElementById('tbody');

function rowTemplate(r){
  const floating = escapeHtml(r.floating_crane);

  return `
  <tr data-floating="${floating}">
    <td><input class="form-control form-control-sm" value="${floating}" disabled></td>
    <td><input class="form-control form-control-sm" name="vendor_flf" value="${escapeHtml(r.vendor_flf)}"></td>
    <td><input class="form-control form-control-sm" name="pbm" value="${escapeHtml(r.pbm)}"></td>
    <td><input class="form-control form-control-sm" name="anchorage" value="${escapeHtml(r.anchorage)}"></td>
    <td class="d-flex gap-2">
      <button class="btn btn-sm btn-primary btnUpdate" type="button">Update</button>
      <button class="btn btn-sm btn-outline-danger btnDelete" type="button">Delete</button>
    </td>
  </tr>`;
}

let flfPageSize = 10;
let flfCurrentPage = 1;
let flfRows = [];

const flfPageInfo = document.getElementById('flfPageInfo');
const flfPageSizeSelect = document.getElementById('flfPageSize');
const flfPageButtons = document.getElementById('flfPageButtons');

function renderFlfPage(page){
  const totalRows = flfRows.length;
  const totalPages = Math.max(1, Math.ceil(totalRows / flfPageSize));
  flfCurrentPage = Math.min(Math.max(page, 1), totalPages);

  const start = (flfCurrentPage - 1) * flfPageSize;
  const end = Math.min(start + flfPageSize, totalRows);
  const pageRows = flfRows.slice(start, end);

  tbody.innerHTML = pageRows.length
    ? pageRows.map(rowTemplate).join('')
    : `<tr><td colspan="5" class="text-center text-muted">No data</td></tr>`;

  flfPageInfo.textContent = `Showing ${totalRows === 0 ? 0 : start + 1} to ${end} of ${totalRows} entries`;
  renderFlfPageButtons(totalPages);
}

function renderFlfPageButtons(totalPages){
  function pageItem(label, page, opts = {}){
    const cls = 'page-item' + (opts.disabled ? ' disabled' : '') + (opts.active ? ' active' : '');
    return `<li class="${cls}"><button class="page-link" type="button" data-page="${page}">${label}</button></li>`;
  }

  const btns = [];
  btns.push(pageItem('&laquo;', 1, { disabled: flfCurrentPage === 1 }));
  btns.push(pageItem('&lsaquo;', flfCurrentPage - 1, { disabled: flfCurrentPage === 1 }));

  const windowSize = 5;
  let startPage = Math.max(1, flfCurrentPage - Math.floor(windowSize / 2));
  let endPage = Math.min(totalPages, startPage + windowSize - 1);
  startPage = Math.max(1, endPage - windowSize + 1);

  for (let p = startPage; p <= endPage; p++){
    btns.push(pageItem(String(p), p, { active: p === flfCurrentPage }));
  }

  btns.push(pageItem('&rsaquo;', flfCurrentPage + 1, { disabled: flfCurrentPage === totalPages }));
  btns.push(pageItem('&raquo;', totalPages, { disabled: flfCurrentPage === totalPages }));

  flfPageButtons.innerHTML = btns.join('');
}

flfPageButtons.addEventListener('click', (e) => {
  const item = e.target.closest('.page-item');
  const btn = e.target.closest('button[data-page]');
  if (!btn || !item || item.classList.contains('disabled') || item.classList.contains('active')) return;
  renderFlfPage(Number(btn.getAttribute('data-page')));
});

flfPageSizeSelect.addEventListener('change', () => {
  flfPageSize = Number(flfPageSizeSelect.value);
  renderFlfPage(1);
});

async function loadFlf(q=''){
  const res = await fetch('/flf?ajax=1&action=list&q=' + encodeURIComponent(q));
  const r = await res.json();
  if (!r.ok){
    flfRows = [];
    tbody.innerHTML = `<tr><td colspan="5" class="text-center text-danger">${escapeHtml(r.msg || 'Error')}</td></tr>`;
    flfPageInfo.textContent = 'Showing 0 to 0 of 0 entries';
    flfPageButtons.innerHTML = '';
    return;
  }
  flfRows = r.data || [];
  renderFlfPage(1);
}

const searchBox = document.getElementById('searchBox');
const btnReset  = document.getElementById('btnReset');

let t = null;
searchBox.addEventListener('input', () => {
  hideAlert();
  clearTimeout(t);
  t = setTimeout(() => loadFlf(searchBox.value.trim()), 250);
});

btnReset.addEventListener('click', () => {
  searchBox.value = '';
  hideAlert();
  loadFlf('');
});

const formCreate = document.getElementById('formCreate');
formCreate.addEventListener('submit', async (e) => {
  e.preventDefault();
  hideAlert();

  const fd = new FormData(formCreate);
  const payload = { action: 'create' };
  for (const [k, v] of fd.entries()) payload[k] = v.toString().trim();

  const r = await postAjax(payload);
  if (r.ok){
    showAlert('success', r.msg || 'OK');
    formCreate.reset();
    loadFlf(searchBox.value.trim());
  } else {
    showAlert('danger', r.msg || 'Gagal');
  }
});

tbody.addEventListener('click', async (e) => {
  const tr = e.target.closest('tr');
  if (!tr) return;
  const floating_crane = tr.getAttribute('data-floating') || '';

  if (e.target.classList.contains('btnUpdate')){
    hideAlert();
    const payload = { action: 'update', floating_crane };
    tr.querySelectorAll('input[name]').forEach(el => {
      payload[el.name] = el.value.trim();
    });

    const r = await postAjax(payload);
    if (r.ok){
      showAlert('success', r.msg || 'Updated');
      loadFlf(searchBox.value.trim());
    } else {
      showAlert('danger', r.msg || 'Gagal update');
    }
  }

  if (e.target.classList.contains('btnDelete')){
    hideAlert();
    if (!floating_crane) return;
    if (!confirm('Hapus FLF ' + floating_crane + ' ?')) return;

    const r = await postAjax({ action: 'delete', floating_crane });
    if (r.ok){
      showAlert('success', r.msg || 'Deleted');
      loadFlf(searchBox.value.trim());
    } else {
      showAlert('danger', r.msg || 'Gagal delete');
    }
  }
});

const formImport = document.getElementById('formImport');
if (formImport) {
  formImport.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideAlert();

    const csvFile = document.getElementById('csvFile');
    if (!csvFile.files.length) return;

    const fd = new FormData();
    fd.append('action', 'import_csv');
    fd.append('csv', csvFile.files[0]);

    const res = await fetch('/flf', { method: 'POST', body: fd });
    const r = await res.json();
    if (r.ok){
      showAlert('success', r.msg || 'Import selesai');
      formImport.reset();
      loadFlf(searchBox.value.trim());
    } else {
      showAlert('danger', r.msg || 'Gagal import');
    }
  });
}

const btnDeleteAll = document.getElementById('btnDeleteAll');
if (btnDeleteAll) {
  btnDeleteAll.addEventListener('click', async () => {
    hideAlert();
    if (!confirm('Hapus SEMUA data FLF? Tindakan ini tidak bisa dibatalkan.')) return;

    const r = await postAjax({ action: 'delete_all' });
    if (r.ok){
      showAlert('success', r.msg || 'Deleted');
      loadFlf(searchBox.value.trim());
    } else {
      showAlert('danger', r.msg || 'Gagal');
    }
  });
}

loadFlf('');
</script>

<%- include('partials/footer') %>
