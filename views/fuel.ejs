<%- include('partials/header', { pageTitle: 'Fuel - MLP Logistic', username, divisi }) %>
<%- include('partials/sidebar', { divisi }) %>

<div class="content" style="display: flex; flex-direction: column; overflow: hidden;">
  <div class="card mb-3" style="flex: 0 0 auto;">
    <div class="card-header card-toggle d-flex justify-content-between align-items-center" role="button"
         data-bs-toggle="collapse" data-bs-target="#collapseInputFuel" aria-expanded="false" aria-controls="collapseInputFuel">
      <h6 class="m-0">Input Fuel</h6>
      <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="collapse" id="collapseInputFuel">
    <div class="card-body">

      <div class="row g-3">
        <div class="col-auto">
          <label for="tahun" class="form-label mb-1">Tahun</label>
          <select id="tahun" class="form-select" style="max-width:150px;" onchange="location.href='?tahun='+this.value+'&bulan='+document.getElementById('bulan').value">
            <% tahunOptions.forEach(function (y) { %>
              <option value="<%= y %>"<%= y === tahun ? ' selected' : '' %>><%= y %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-auto">
          <label for="bulan" class="form-label mb-1">Bulan</label>
          <select id="bulan" class="form-select" style="max-width:120px;" onchange="location.href='?tahun='+document.getElementById('tahun').value+'&bulan='+this.value">
            <% bulanNames.forEach(function (m) { %>
              <option value="<%= m %>"<%= m === bulan ? ' selected' : '' %>><%= m %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-auto">
          <label for="ppnRate" class="form-label mb-1">PPN</label>
          <div class="input-group" style="max-width:150px;">
            <input type="text" inputmode="decimal" id="ppnRate" class="form-control rate-input" data-field="ppn_rate" value="<%= ppnRateDisplay %>">
            <span class="input-group-text">%</span>
          </div>
        </div>
        <div class="col-auto">
          <label for="pbbkbRate" class="form-label mb-1">PBBKB</label>
          <div class="input-group" style="max-width:150px;">
            <input type="text" inputmode="decimal" id="pbbkbRate" class="form-control rate-input" data-field="pbbkb_rate" value="<%= pbbkbRateDisplay %>">
            <span class="input-group-text">%</span>
          </div>
        </div>
        <div class="col-auto">
          <label for="pph22Rate" class="form-label mb-1">PPH22</label>
          <div class="input-group" style="max-width:150px;">
            <input type="text" inputmode="decimal" id="pph22Rate" class="form-control rate-input" data-field="pph22_rate" value="<%= pph22RateDisplay %>">
            <span class="input-group-text">%</span>
          </div>
        </div>
      </div>
    </div>
    </div>
  </div>

  <div class="card shadow-sm" style="flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column;">
    <div class="card-body p-0" style="min-height: 0; display: flex; flex-direction: column;">
      <div class="table-responsive fuel-table-scroll" style="min-height: 0; overflow-y: auto;">
      <table class="table mb-0 align-middle">
        <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
          <tr>
            <th class="py-3 px-4 text-center align-middle text-nowrap">Bulan-Tahun</th>
            <th class="py-3 px-4 text-center align-middle">Periode</th>
            <th class="py-3 px-4 text-center align-middle">Pertamina</th>
            <th class="py-3 px-4 text-center align-middle">PPN</th>
            <th class="py-3 px-4 text-center align-middle">PBBKB</th>
            <th class="py-3 px-4 text-center align-middle">PPH22</th>
            <th class="py-3 px-4 text-center align-middle">Total</th>
            <th class="py-3 px-4 text-center align-middle">ICI-3</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function (row) { %>
            <tr class="fuel-row">
              <% if (row.periode === 1) { %>
              <td class="px-4" rowspan="2"><%= row.bulanTahun %></td>
              <% } %>
              <td class="px-4"><%= row.periode %></td>
              <td class="px-4">
                <input type="text" inputmode="decimal" class="form-control pertamina-input"
                       name="pertamina[<%= row.bulanTahun %>][<%= row.periode %>]"
                       data-field="pertamina" data-bulan-tahun="<%= row.bulanTahun %>" data-periode="<%= row.periode %>"
                       value="<%= row.pertaminaDisplay %>">
              </td>
              <td class="px-4"><input type="text" class="form-control ppn-output" readonly tabindex="-1"></td>
              <td class="px-4"><input type="text" class="form-control pbbkb-output" readonly tabindex="-1"></td>
              <td class="px-4"><input type="text" class="form-control pph22-output" readonly tabindex="-1"></td>
              <td class="px-4"><input type="text" class="form-control total-output" readonly tabindex="-1"></td>
              <% if (row.periode === 1) { %>
              <td class="px-4" rowspan="2">
                <input type="text" inputmode="decimal" class="form-control ici3-input"
                       name="ici3[<%= row.bulanTahun %>]"
                       data-field="ici3" data-bulan-tahun="<%= row.bulanTahun %>"
                       value="<%= row.ici3Display %>">
              </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</div>

<script>
  // Effective (carried-forward) PPN/PBBKB/PPH22 rate per bulan_tahun, computed
  // server-side so each row uses the rate that was in force for its own month.
  const fuelRatesByMonth = <%- JSON.stringify(ratesByMonth) %>;
  const DEFAULT_FUEL_RATES = { ppnRate: 11, pbbkbRate: 7.5, pph22Rate: 0.3 };

  function parseNumber(str) {
    return parseFloat(String(str).replace(/,/g, '')) || 0;
  }

  function formatNumber(n) {
    return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calcRow(input) {
    const row = input.closest('tr');

    if (input.value.trim() === '') {
      row.querySelector('.ppn-output').value   = '';
      row.querySelector('.pbbkb-output').value = '';
      row.querySelector('.pph22-output').value = '';
      row.querySelector('.total-output').value = '';
      return;
    }

    const rates = fuelRatesByMonth[input.dataset.bulanTahun] || DEFAULT_FUEL_RATES;
    const pertamina = parseNumber(input.value);
    const ppnRate   = rates.ppnRate / 100;
    const pbbkbRate = rates.pbbkbRate / 100;
    const pph22Rate = rates.pph22Rate / 100;

    const ppn   = pertamina * ppnRate;
    const pbbkb = pertamina * pbbkbRate;
    const pph22 = pertamina * pph22Rate;
    const total = pertamina + ppn + pbbkb + pph22;

    row.querySelector('.ppn-output').value   = formatNumber(ppn);
    row.querySelector('.pbbkb-output').value = formatNumber(pbbkb);
    row.querySelector('.pph22-output').value = formatNumber(pph22);
    row.querySelector('.total-output').value = formatNumber(total);
  }

  function calcAllRows() {
    document.querySelectorAll('.pertamina-input').forEach(calcRow);
  }

  function saveRow(input) {
    const body = new URLSearchParams({
      action: 'save_fuel',
      bulan_tahun: input.dataset.bulanTahun,
      periode: input.dataset.periode,
      field: input.dataset.field,
      value: parseNumber(input.value),
    });
    fetch(window.location.pathname, { method: 'POST', body });
  }

  function saveIci3(input) {
    [1, 2].forEach(function (periode) {
      const body = new URLSearchParams({
        action: 'save_fuel',
        bulan_tahun: input.dataset.bulanTahun,
        periode: periode,
        field: input.dataset.field,
        value: parseNumber(input.value),
      });
      fetch(window.location.pathname, { method: 'POST', body });
    });
  }

  function saveRate(input) {
    const tahun = document.getElementById('tahun').value;
    const bulan = document.getElementById('bulan').value;
    const bulanTahun = bulan + '-' + String(tahun).slice(-2);
    const body = new URLSearchParams({
      action: 'save_fuel_rate',
      bulan_tahun: bulanTahun,
      field: input.dataset.field,
      value: parseNumber(input.value),
    });
    fetch(window.location.pathname, { method: 'POST', body }).then(function () {
      location.reload();
    });
  }

  document.querySelectorAll('.pertamina-input').forEach(function (input) {
    input.addEventListener('input', function () {
      calcRow(input);
    });

    input.addEventListener('blur', function () {
      if (input.value !== '') {
        input.value = formatNumber(parseNumber(input.value));
      }
      saveRow(input);
    });
  });

  document.querySelectorAll('.ici3-input').forEach(function (input) {
    input.addEventListener('blur', function () {
      if (input.value !== '') {
        input.value = formatNumber(parseNumber(input.value));
      }
      saveIci3(input);
    });
  });

  document.querySelectorAll('.rate-input').forEach(function (input) {
    input.addEventListener('blur', function () {
      if (input.value !== '') {
        input.value = parseNumber(input.value);
      }
      saveRate(input);
    });
  });

  calcAllRows();
</script>

<%- include('partials/footer') %>
