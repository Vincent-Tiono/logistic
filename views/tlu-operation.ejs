<%- include('partials/header', { pageTitle: 'TLU Operation', username, divisi }) %>
<%- include('partials/sidebar', { divisi }) %>

  <div class="content">

    <div class="d-flex align-items-center justify-content-between mb-3">
      <h4 class="m-0">TLU Operation</h4>
    </div>

    <div class="card" id="allOperationsCard">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h5 class="m-0">All Years / All Vessels</h5>
          <div class="small text-muted" id="allOperationsSummary"></div>
        </div>
        <div class="table-responsive">
          <table class="table table-bordered table-sm align-middle mb-0" id="allOperationsTable">
            <thead class="table-light"><tr id="allOperationsHeaderRow"></tr></thead>
            <tbody id="allOperationsBody">
              <tr><td class="text-center text-muted py-3">Memuat data...</td></tr>
            </tbody>
          </table>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
          <div class="d-flex align-items-center gap-2 small text-muted">
            Show
            <select id="allOperationsPageSize" class="form-select form-select-sm" style="width:auto;">
              <option value="10">10</option>
              <option value="25">25</option>
              <option value="50">50</option>
              <option value="100">100</option>
            </select>
            entries (<span id="allOperationsPageInfo">Showing 0 to 0 of 0 entries</span>)
          </div>
          <nav>
            <ul class="pagination pagination-sm mb-0" id="allOperationsPageButtons"></ul>
          </nav>
        </div>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body">
        <h5 class="mb-3">Cycle Time — Per Vessel</h5>
        <div class="row g-3">
          <div class="col-md-3">
            <label for="cycle_year" class="form-label fw-semibold">Pilih Tahun</label>
            <select id="cycle_year" class="form-select">
              <option value="">-- Pilih Tahun --</option>
            </select>
          </div>
          <div class="col-md-3">
            <label for="cycle_month" class="form-label fw-semibold">Pilih Bulan</label>
            <select id="cycle_month" class="form-select" disabled>
              <option value="">-- Pilih Bulan --</option>
            </select>
          </div>
          <div class="col-md-6">
            <label for="cycle_no_pk" class="form-label fw-semibold">Pilih Mother Vessel (No PK)</label>
            <select id="cycle_no_pk" class="form-select" disabled>
              <option value="">-- Pilih Mother Vessel --</option>
            </select>
          </div>
        </div>

        <% if (!vesselPeriods || !vesselPeriods.length) { %>
          <div class="form-text text-muted">
            Belum ada Mother Vessel dengan Laycan Start pada Data Barges.
          </div>
        <% } %>

        <div class="mt-3 d-none" id="cycleTimeBox">
          <% if ((divisi || '').toUpperCase() === 'IT') { %>
          <div class="border rounded p-3 mb-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
              <div>
                <h6 class="mb-1">Import CSV</h6>
                <div class="small text-muted">Import data operasi untuk vessel ini dari file CSV.</div>
              </div>
              <form id="operationImportForm" class="d-flex align-items-center flex-nowrap gap-2">
                <input type="file" name="csv" id="operationCsvFile" class="form-control form-control-sm" accept=".csv,text/csv" required>
                <button type="submit" class="btn btn-sm btn-primary flex-shrink-0" id="operationImportButton">Import CSV</button>
              </form>
            </div>
            <div class="alert d-none mt-3 mb-0" id="operationCsvStatus" role="alert"></div>
          </div>
          <% } %>
          <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="small text-muted" id="cycleTimeSummary"></div>
            <a class="btn btn-sm btn-outline-primary disabled" id="downloadCycleTimeCsv" href="#" aria-disabled="true">Download CSV</a>
          </div>
          <div class="alert alert-primary py-2 mb-3" role="note">
            Klik salah satu baris untuk melihat dan mengedit data operasi.
          </div>
          <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle mb-0" id="cycleTimeTable">
              <thead class="table-light"><tr id="cycleTimeHeaderRow"></tr></thead>
              <tbody id="cycleTimeBody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body">
        <h5 class="mb-3">Export CSV</h5>
        <div class="row g-3 mb-3">
          <div class="col-md-6 col-xl-3">
            <label class="d-block border rounded p-2 h-100">
              <input type="radio" name="tlu_export_scope" value="vessel" checked>
              <span class="fw-semibold">Satu Mother Vessel</span>
              <div class="small text-muted">Export seluruh TB dari satu Mother Vessel.</div>
            </label>
          </div>
          <div class="col-md-6 col-xl-3">
            <label class="d-block border rounded p-2 h-100">
              <input type="radio" name="tlu_export_scope" value="month">
              <span class="fw-semibold">Satu Bulan</span>
              <div class="small text-muted">Gabungkan semua Mother Vessel dalam bulan terpilih.</div>
            </label>
          </div>
          <div class="col-md-6 col-xl-3">
            <label class="d-block border rounded p-2 h-100">
              <input type="radio" name="tlu_export_scope" value="year">
              <span class="fw-semibold">Satu Tahun</span>
              <div class="small text-muted">Gabungkan seluruh bulan dan Mother Vessel dalam satu tahun.</div>
            </label>
          </div>
          <div class="col-md-6 col-xl-3">
            <label class="d-block border rounded p-2 h-100">
              <input type="radio" name="tlu_export_scope" value="all">
              <span class="fw-semibold">Semua Tahun</span>
              <div class="small text-muted">Gabungkan seluruh data Mother Vessel dalam satu CSV.</div>
            </label>
          </div>
        </div>

        <div class="row g-3 align-items-end">
          <div class="col-md-3" id="exportYearGroup">
            <label for="export_year" class="form-label fw-semibold">Tahun</label>
            <select id="export_year" class="form-select">
              <option value="">-- Pilih Tahun --</option>
            </select>
          </div>
          <div class="col-md-3" id="exportMonthGroup">
            <label for="export_month" class="form-label fw-semibold">Bulan</label>
            <select id="export_month" class="form-select" disabled>
              <option value="">-- Pilih Bulan --</option>
            </select>
          </div>
          <div class="col-md-4" id="exportVesselGroup">
            <label for="export_no_pk" class="form-label fw-semibold">Mother Vessel (No PK)</label>
            <select id="export_no_pk" class="form-select" disabled>
              <option value="">-- Pilih Mother Vessel --</option>
            </select>
          </div>
          <div class="col-md-2">
            <button type="button" class="btn btn-success w-100" id="downloadGroupedExport">Export CSV</button>
          </div>
        </div>
        <div class="form-text mt-3">
          Data setiap Mother Vessel diurutkan berdasarkan Discharge Sequence. Satu baris kosong memisahkan Mother Vessel pada export gabungan.
        </div>
        <div class="alert d-none mt-3 mb-0" id="groupedExportStatus" role="alert"></div>
      </div>
    </div>

  </div>

  <div class="modal fade" id="operationDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="operationDetailSubtitle"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body row g-3" id="operationDetailBody"></div>
        <div class="modal-footer">
          <span class="me-auto small" id="operationSaveStatus"></span>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="operationSaveButton">Save</button>
        </div>
      </div>
    </div>
  </div>

<script type="module">
import {
  displayValue, headerKeys, buildHeaderCells, groupRowsByVessel, buildRowValues, fetchJson,
} from '/assets/js/tlu-operation-shared.mjs';
import { init as initCycleTime } from '/assets/js/tlu-operation-cycle-time.mjs';
import { init as initExportCsv } from '/assets/js/tlu-operation-export-csv.mjs';

// Port of the "All Years / All Vessels" landing table from
// Operation/8tluoperation.php. Per docs/adr/0001-tlu-grouped-export-computes-client-side.md,
// the server hands over raw (vessel-defaulted, not cycle-time-computed) rows;
// every cycle-time column below is computed via the shared
// assets/js/tlu-operation-shared.mjs module, exactly as the legacy inline
// script does. The "Cycle Time — Per Vessel" card (timeline table, row-detail
// edit modal, CSV import — issue #11) and the "Export CSV" card live in their
// own submodules; see docs/adr/0004-tlu-operation-view-submodules.md.
//
// The "All Years / All Vessels" landing table stays read-only, matching
// legacy (it never had edit-modal wiring either).

const vesselPeriods = <%- JSON.stringify(vesselPeriods || []) %>;
const optionLists = <%- JSON.stringify(optionLists || {}) %>;

buildHeaderCells(document.getElementById('allOperationsHeaderRow'), false);

// ===== All Years / All Vessels (landing table, client-side paginated) =====

let allOperationsPageSize = 10;
let allOperationsCurrentPage = 1;
let allOperationsDisplayEntries = [];

const allOperationsBody = document.getElementById('allOperationsBody');
const allOperationsSummary = document.getElementById('allOperationsSummary');
const allOperationsPageInfo = document.getElementById('allOperationsPageInfo');
const allOperationsPageSizeSelect = document.getElementById('allOperationsPageSize');
const allOperationsPageButtons = document.getElementById('allOperationsPageButtons');

function renderAllOperationsPage(page) {
  const totalRows = allOperationsDisplayEntries.length;
  const totalPages = Math.max(1, Math.ceil(totalRows / allOperationsPageSize));
  allOperationsCurrentPage = Math.min(Math.max(page, 1), totalPages);

  const start = (allOperationsCurrentPage - 1) * allOperationsPageSize;
  const end = Math.min(start + allOperationsPageSize, totalRows);
  const pageEntries = allOperationsDisplayEntries.slice(start, end);

  allOperationsBody.innerHTML = pageEntries.length
    ? pageEntries.map(entry => entry === null
        ? `<tr class="table-secondary"><td colspan="${headerKeys.length}"></td></tr>`
        : `<tr>${buildRowValues(entry.row, entry.allRows, entry.rowIndexInVessel, headerKeys).map(value => `<td>${displayValue(value)}</td>`).join('')}</tr>`
      ).join('')
    : `<tr><td colspan="${headerKeys.length}" class="text-center text-muted py-3">Data tidak ditemukan.</td></tr>`;

  allOperationsSummary.textContent = totalRows ? `${totalRows} baris` : '';
  allOperationsPageInfo.textContent = `Showing ${totalRows === 0 ? 0 : start + 1} to ${end} of ${totalRows} entries`;
  renderAllOperationsPageButtons(totalPages);
}

function renderAllOperationsPageButtons(totalPages) {
  function pageItem(label, page, opts = {}) {
    const cls = 'page-item' + (opts.disabled ? ' disabled' : '') + (opts.active ? ' active' : '');
    return `<li class="${cls}"><button class="page-link" type="button" data-page="${page}">${label}</button></li>`;
  }

  const btns = [];
  btns.push(pageItem('&laquo;', 1, { disabled: allOperationsCurrentPage === 1 }));
  btns.push(pageItem('&lsaquo;', allOperationsCurrentPage - 1, { disabled: allOperationsCurrentPage === 1 }));

  const windowSize = 5;
  let startPage = Math.max(1, allOperationsCurrentPage - Math.floor(windowSize / 2));
  let endPage = Math.min(totalPages, startPage + windowSize - 1);
  startPage = Math.max(1, endPage - windowSize + 1);

  for (let p = startPage; p <= endPage; p++) {
    btns.push(pageItem(String(p), p, { active: p === allOperationsCurrentPage }));
  }

  btns.push(pageItem('&rsaquo;', allOperationsCurrentPage + 1, { disabled: allOperationsCurrentPage === totalPages }));
  btns.push(pageItem('&raquo;', totalPages, { disabled: allOperationsCurrentPage === totalPages }));

  allOperationsPageButtons.innerHTML = btns.join('');
}

allOperationsPageButtons.addEventListener('click', (e) => {
  const item = e.target.closest('.page-item');
  const btn = e.target.closest('button[data-page]');
  if (!btn || !item || item.classList.contains('disabled') || item.classList.contains('active')) return;
  renderAllOperationsPage(Number(btn.getAttribute('data-page')));
});

allOperationsPageSizeSelect.addEventListener('change', () => {
  allOperationsPageSize = Number(allOperationsPageSizeSelect.value);
  renderAllOperationsPage(1);
});

(async function loadAllOperations() {
  const result = await fetchJson('/tlu-operation?ajax=1&action=all_operations');
  const rows = result.ok ? (result.data || []) : [];
  allOperationsDisplayEntries = groupRowsByVessel(rows).flatMap((group, groupIndex) => [
    ...(groupIndex > 0 ? [null] : []),
    ...group.map((row, rowIndexInVessel) => ({ row, allRows: group, rowIndexInVessel }))
  ]);
  renderAllOperationsPage(1);
})();

initCycleTime({ vesselPeriods, optionLists });
initExportCsv({ vesselPeriods });
</script>

<%- include('partials/footer') %>
