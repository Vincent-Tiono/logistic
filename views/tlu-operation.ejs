<%- include('partials/header', { pageTitle: 'TLU Operation', username, divisi }) %>
<%- include('partials/sidebar', { divisi }) %>

<main class="main">
  <div class="content">

    <div class="d-flex align-items-center justify-content-between mb-3">
      <h4 class="m-0">TLU Operation</h4>
    </div>

    <div class="card" id="allOperationsCard">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h5 class="m-0">All Years / All Vessels</h5>
          <div class="small text-muted" id="allOperationsSummary"></div>
        </div>
        <div class="table-responsive">
          <table class="table table-bordered table-sm align-middle mb-0" id="allOperationsTable">
            <thead class="table-light"><tr id="allOperationsHeaderRow"></tr></thead>
            <tbody id="allOperationsBody">
              <tr><td class="text-center text-muted py-3">Memuat data...</td></tr>
            </tbody>
          </table>
        </div>
        <div class="d-flex align-items-center justify-content-between mt-3">
          <div class="small text-muted" id="allOperationsPageInfo"></div>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="allOperationsPrev">Previous</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="allOperationsNext">Next</button>
          </div>
        </div>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body">
        <h5 class="mb-3">Cycle Time — Per Vessel</h5>
        <div class="row g-3">
          <div class="col-md-3">
            <label for="cycle_year" class="form-label fw-semibold">Pilih Tahun</label>
            <select id="cycle_year" class="form-select">
              <option value="">-- Pilih Tahun --</option>
            </select>
          </div>
          <div class="col-md-3">
            <label for="cycle_month" class="form-label fw-semibold">Pilih Bulan</label>
            <select id="cycle_month" class="form-select" disabled>
              <option value="">-- Pilih Bulan --</option>
            </select>
          </div>
          <div class="col-md-6">
            <label for="cycle_no_pk" class="form-label fw-semibold">Pilih Mother Vessel (No PK)</label>
            <select id="cycle_no_pk" class="form-select" disabled>
              <option value="">-- Pilih Mother Vessel --</option>
            </select>
          </div>
        </div>

        <% if (!vesselPeriods || !vesselPeriods.length) { %>
          <div class="form-text text-muted">
            Belum ada Mother Vessel dengan Laycan Start pada Data Barges.
          </div>
        <% } %>

        <div class="mt-3 d-none" id="cycleTimeBox">
          <% if ((divisi || '').toUpperCase() === 'IT') { %>
          <div class="border rounded p-3 mb-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
              <div>
                <h6 class="mb-1">Import CSV</h6>
                <div class="small text-muted">Import data operasi untuk vessel ini dari file CSV.</div>
              </div>
              <form id="operationImportForm" class="d-flex align-items-center flex-nowrap gap-2">
                <input type="file" name="csv" id="operationCsvFile" class="form-control form-control-sm" accept=".csv,text/csv" required>
                <button type="submit" class="btn btn-sm btn-primary flex-shrink-0" id="operationImportButton">Import CSV</button>
              </form>
            </div>
            <div class="alert d-none mt-3 mb-0" id="operationCsvStatus" role="alert"></div>
          </div>
          <% } %>
          <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="small text-muted" id="cycleTimeSummary"></div>
          </div>
          <div class="alert alert-primary py-2 mb-3" role="note">
            Klik salah satu baris untuk melihat dan mengedit data operasi.
          </div>
          <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle mb-0" id="cycleTimeTable">
              <thead class="table-light"><tr id="cycleTimeHeaderRow"></tr></thead>
              <tbody id="cycleTimeBody"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  </div>

  <div class="modal fade" id="operationDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="operationDetailSubtitle"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body row g-3" id="operationDetailBody"></div>
        <div class="modal-footer">
          <span class="me-auto small" id="operationSaveStatus"></span>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" id="operationSaveButton">Save</button>
        </div>
      </div>
    </div>
  </div>
</main>

